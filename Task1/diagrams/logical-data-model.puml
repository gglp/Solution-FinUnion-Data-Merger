@startuml 01-logical-data-model
title Логическая модель ключевых данных FinUnion Group после объединения с RetailBank

hide circle
hide empty methods
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 6
skinparam class {
  BackgroundColor<<участники>> #E7F1FB
  BackgroundColor<<справочник>> #F0EFEC
  BackgroundColor<<соглашение>> #E5F4E4
  BackgroundColor<<операция>> #F9EEDA
  BackgroundColor<<обслуживание>> #EFEDFF
}

' ===== Участники =====
entity "Клиент" as party <<участники>> {
  * ид_клиента : единый клиентский идентификатор <<PK>>
  --
  * тип_клиента : ФЛ / ИП / ЮЛ
  * фио_или_наименование
  дата_рождения
  инн
  снилс
  документ_удостоверяющий_личность
  огрн
  телефон
  электронная_почта
  адрес_регистрации
  адрес_фактический
  резидентство
  ид_сегмента <<FK>>
  ид_подразделения_обслуживания <<FK>>
  * статус
  дата_актуализации
}

entity "Кросс-ссылка идентификаторов" as xref <<участники>> {
  * ид_ссылки <<PK>>
  --
  * ид_клиента <<FK>>
  * система_источник
  * локальный_идентификатор
  правило_сопоставления
  оценка_совпадения
  * статус_сопоставления
  период_действия
}

entity "Связь клиентов" as rel <<участники>> {
  * ид_связи <<PK>>
  --
  * ид_клиента_1 <<FK>>
  * ид_клиента_2 <<FK>>
  * тип_связи
  доля_владения
  ид_документа_основания <<FK>>
  период_действия
}

' ===== Справочники =====
entity "Клиентский сегмент" as segment <<справочник>> {
  * ид_сегмента <<PK>>
  --
  * код
  * наименование
  * бизнес_линия
  правила_отнесения
  период_действия
}

entity "Подразделение" as branch <<справочник>> {
  * ид_подразделения <<PK>>
  --
  * код
  * наименование
  * тип
  * организация : FU / RB
  регион
  адрес
  ид_родительского <<FK>>
  * статус
}

entity "Продукт" as product <<справочник>> {
  * ид_продукта <<PK>>
  --
  * код
  * наименование
  * тип_продукта
  * бизнес_линия
  валюта
  * статус
  организация_владелец
  ид_целевого_продукта <<FK>>
}

entity "Тариф" as tariff <<справочник>> {
  * ид_тарифа <<PK>>
  --
  * ид_продукта <<FK>>
  * версия
  ставка
  комиссии
  лимиты
  ид_сегмента <<FK>>
  * период_действия
}

' ===== Соглашения =====
entity "Договор" as agreement <<соглашение>> {
  * ид_договора <<PK>>
  --
  * номер
  * тип_договора
  * ид_клиента <<FK>>
  * ид_продукта <<FK>>
  ид_тарифа <<FK>>
  ид_подразделения <<FK>>
  ид_рамочного_договора <<FK>>
  канал_продажи
  * дата_заключения
  дата_окончания
  * статус
  * система_источник
}

entity "Счёт" as account <<соглашение>> {
  * ид_счёта <<PK>>
  --
  * номер_счёта
  * балансовый_счёт
  * валюта
  * тип_счёта
  * ид_договора <<FK>>
  ид_подразделения <<FK>>
  * дата_открытия
  дата_закрытия
  * статус
  ограничения
}

entity "Карта" as pcard <<соглашение>> {
  * ид_карты <<PK>>
  --
  * токен_номера_карты
  маскированный_номер
  * платёжная_система
  * тип_карты
  * ид_держателя <<FK>>
  * ид_счёта <<FK>>
  * ид_договора <<FK>>
  ид_тарифа <<FK>>
  срок_действия
  * статус
}

entity "Кредит" as loan <<соглашение>> {
  * ид_кредита <<PK>>
  --
  * ид_договора <<FK>>
  * ид_ссудного_счёта <<FK>>
  * сумма
  * валюта
  * ставка
  * срок
  график_платежей
  основной_долг
  просроченная_задолженность
  дней_просрочки
  обеспечение
  категория_качества
}

' ===== Операции =====
entity "Платёж" as payment <<операция>> {
  * ид_платежа <<PK>>
  --
  * номер_документа
  * тип_платежа
  * ид_плательщика <<FK>>
  * ид_счёта_списания <<FK>>
  * реквизиты_получателя
  * сумма
  * валюта
  назначение
  * канал
  * статус
  * дата_создания
  дата_исполнения
}

entity "Операция" as operation <<операция>> {
  * ид_операции <<PK>>
  --
  * ид_счёта <<FK>>
  * дата_время
  дата_валютирования
  * сумма
  * валюта
  * направление
  * код_операции
  ид_платежа <<FK>>
  ид_карты <<FK>>
  * статус
  * система_источник
}

' ===== Обслуживание =====
entity "Обращение" as appeal <<обслуживание>> {
  * ид_обращения <<PK>>
  --
  * ид_клиента <<FK>>
  * канал
  * тип
  тема
  текст
  ид_договора <<FK>>
  ид_операции <<FK>>
  приоритет
  * статус
  исполнитель
  нормативный_срок
  * дата_создания
  дата_закрытия
}

entity "Документ клиента" as doc <<обслуживание>> {
  * ид_документа <<PK>>
  --
  * ид_клиента <<FK>>
  * тип_документа
  * ссылка_на_объект
  контрольная_сумма
  ид_договора <<FK>>
  срок_действия
  статус
  * дата_получения
}

' ===== Связи =====
party ||--|{ xref : "идентифицируется в системах"
party ||--o{ rel : "участник 1"
party ||--o{ rel : "участник 2"
segment ||--o{ party : "классифицирует"
branch ||--o{ party : "обслуживает"
branch |o--o{ branch : "входит в"

product ||--|{ tariff : "имеет версии условий"
segment |o--o{ tariff : "применяется к"
product |o--o{ product : "заменяется целевым"

party ||--o{ agreement : "заключает"
product ||--o{ agreement : "предоставляется по"
tariff |o--o{ agreement : "определяет условия"
branch |o--o{ agreement : "оформляет"
agreement |o--o{ agreement : "рамочный договор"

agreement ||--|{ account : "открывает"
agreement ||--o{ pcard : "выпускает"
agreement ||--o| loan : "предоставляет"
account ||--o| loan : "учитывает задолженность"
account ||--o{ pcard : "привязана к"
party ||--o{ pcard : "держатель"

account ||--o{ operation : "отражает движение"
payment |o--o{ operation : "исполняется"
pcard |o--o{ operation : "инициирует"
party ||--o{ payment : "плательщик"
account ||--o{ payment : "счёт списания"

party ||--o{ appeal : "обращается"
agreement |o--o{ appeal : "предмет обращения"
operation |o--o{ appeal : "оспаривается"

party ||--o{ doc : "предоставляет"
agreement |o--o{ doc : "подтверждается"
doc |o--o{ rel : "основание"

legend right
  Цвет — группа сущностей:
  голубой — участники
  серый — справочники (MDM)
  зелёный — соглашения
  жёлтый — операции
  фиолетовый — обслуживание
  * — обязательный атрибут
endlegend

@enduml
